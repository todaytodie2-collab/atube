# ===================================================
# A TuBe Configuration Template (.env.example)
# ===================================================

# Environment mode: development / production
ATUBE_ENV=production

# The Movie Database (TMDB) API Key
# Replace with your TMDB v3 API Key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Admin Access Token for sensitive operations
ATUBE_ADMIN_TOKEN=your_secure_random_admin_token_here

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085,capacitor://localhost,ionic://localhost

# Rate Limiting configuration (requests per minute)
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_STREAM_PER_MIN=180

# Oscar VOD API Token (optional)
OSCAR_VOD_TOKEN=

# TLS Verification: set to 1 to strictly enforce certificate checks
ATUBE_STRICT_TLS=1

